[Unit]
Description=MessMate shared API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=messmate
Group=messmate
WorkingDirectory=/opt/messmate
EnvironmentFile=/etc/messmate/api.env
ExecStart=/usr/bin/node /opt/messmate/apps/api/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

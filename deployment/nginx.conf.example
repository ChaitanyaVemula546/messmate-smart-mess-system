# Replace domain and certificate paths with your actual deployment configuration.
server {
    listen 80;
    server_name campus.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name campus.example.invalid;
    ssl_certificate /etc/ssl/messmate/fullchain.pem;
    ssl_certificate_key /etc/ssl/messmate/privkey.pem;
    client_max_body_size 800k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}

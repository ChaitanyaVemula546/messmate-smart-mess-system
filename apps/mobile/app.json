{
  "expo": {
    "name": "MessMate",
    "slug": "messmate-smart-mess-system",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "ios": {
      "bundleIdentifier": "org.messmate.student",
      "supportsTablet": true
    },
    "android": {
      "package": "org.messmate.student",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173d30",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "extra": {
      "notice": "One shared MessMate API. No cloud build subscription required."
    }
  }
}

# Run pnpm setup to create private development values. Never use these blanks in production.
DATABASE_URL=pglite://.data/messmate
AUTH_SECRET=
# Devices use individually generated tokens; this legacy variable is not a shared access bypass.
DEVICE_API_SECRET=
APP_URL=http://localhost:3000
API_PORT=4000
# Use 127.0.0.1 behind a local reverse proxy; 0.0.0.0 permits local phone testing.
API_HOST=0.0.0.0
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_BASE_URL=/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api
DEMO_PASSWORD=
NODE_ENV=development

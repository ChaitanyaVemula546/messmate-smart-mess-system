# Placeholders only. Use pnpm setup to generate working local development values.
# Vercel requires these three values in Project Settings > Environment Variables.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POOLED_HOST/YOUR_DATABASE?sslmode=verify-full
AUTH_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET
APP_URL=https://YOUR_PROJECT.vercel.app
# Optional; defaults to 3 connections per Vercel instance, 10 for standalone Node.
DB_POOL_MAX=
# Vercel build only; set to 1 in Vercel to honor the pinned pnpm version.
ENABLE_EXPERIMENTAL_COREPACK=
# Production web uses the API bundled into Next.js at the same origin.
NEXT_PUBLIC_API_BASE_URL=/api
# Only used by the separate Express server in local development.
API_INTERNAL_URL=
API_PORT=
API_HOST=
# Expo: public HTTPS address only. Never put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PROJECT.vercel.app/api
# Fictional development data only; never set this on Vercel.
DEMO_PASSWORD=
# Bootstrap script only. Remove these private values after creating the admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
